<module name="tutorial" comment="教程系统配置">
    
    <!-- 教程步骤配置 -->
    <bean name="TutorialStepConfig" comment="教程步骤配置">
        <var name="stepId" type="string" comment="步骤ID"/>
        <var name="stepName" type="string" comment="步骤名称"/>
        <var name="order" type="int" comment="步骤顺序"/>
    </bean>
    
    <!-- 教程基础配置 -->
    <bean name="TutorialConfig" comment="教程基础配置">
        <var name="id" type="string" comment="教程配置ID"/>
        <var name="steps" type="list,TutorialStepConfig" comment="教程步骤列表"/>
    </bean>

</module>

<module name="mutation" comment="变异系统配置">
    
    <!-- 变异权重配置 -->
    <bean name="MutationWeightConfig" comment="变异权重配置">
        <var name="name" type="string" comment="变异名称"/>
        <var name="weight" type="int" comment="权重值"/>
    </bean>
    
    <!-- 变异基础配置 -->
    <bean name="MutationConfig" comment="变异基础配置">
        <var name="id" type="string" comment="变异ID"/>
        <var name="multi" type="float" comment="倍数"/>
        <var name="cost" type="int" comment="成本"/>
        <var name="stack" type="bool?" comment="是否可叠加"/>
    </bean>

</module>
